# Required environment variables
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>?appName=Cluster0
SESSION_SECRET=<generate-a-32-byte-hex-string>
CLIENT_URL=http://localhost:5173

# Google OAuth (for patient login)
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Admin credentials (set these to create the immutable super-admin)
ADMIN_ID=admin@clinic.local
ADMIN_PASSWORD_HASH=<bcrypt-hash-of-password>

# Cron secret (for slot generation endpoint)
CRON_SECRET=<generate-a-32-byte-hex-string>

# Node environment
NODE_ENV=development